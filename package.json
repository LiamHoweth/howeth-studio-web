{
  "name": "howethstudio-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:security && next build && node scripts/elevenward-document-language.cjs",
    "start": "node scripts/serve-site.mjs",
    "lint": "eslint .",
    "postinstall": "node scripts/security-patches.cjs --apply && node scripts/security-regressions.cjs",
    "validate:security": "node scripts/security-gate-tests.cjs && node scripts/security-audit.cjs",
    "test:hosting": "node --test scripts/serve-site.test.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serve": "^14.2.5",
    "serve-handler": "^6.1.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^20.17.12",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.2",
    "railway": "^3.10.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  }
}
